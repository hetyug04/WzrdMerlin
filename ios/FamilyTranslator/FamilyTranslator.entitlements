<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Must match the App Group ID in SharedDefaults.appGroupID and in the extension entitlements -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.yourcompany.familytranslator</string>
    </array>
</dict>
</plist>
